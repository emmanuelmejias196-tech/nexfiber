# =====================================================================
# Cable Tartak API - variables de entorno
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a Git.
# En Render define estas mismas variables en el panel del servicio.
# =====================================================================

# --- General ---------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0
LOG_LEVEL=info

# --- Base de datos (Render: la cadena la genera el panel) ------------
# Desarrollo local:
# DATABASE_URL=postgresql://tartak:tartak@localhost:5432/cable_tartak
# DATABASE_URL=postgresql://usuario:clave@host:5432/cable_tartak
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Aplica las migraciones al arrancar el servicio (util en el primer deploy).
MIGRATE_ON_BOOT=false

# --- Autenticacion ---------------------------------------------------
# OBLIGATORIA en produccion. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=cable-tartak-api
JWT_ACCESS_TTL=1800
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# Si es true, crear la clave exige ademas un codigo de un solo uso.
ACTIVATION_REQUIRES_OTP=false

# --- Seguridad -------------------------------------------------------
# Clave de la consola de oficina (cabecera x-admin-key). Sin ella, /api/admin queda deshabilitado.
ADMIN_API_KEY=
# Lista de origenes permitidos separados por coma. * permite todos.
CORS_ORIGINS=*
RATE_LIMIT_GLOBAL=600
RATE_LIMIT_AUTH=10
RATE_LIMIT_WRITE=60
PASSWORD_MIN_LENGTH=6
PASSWORD_MAX_LENGTH=128

# --- Pagos C2P -------------------------------------------------------
# Activa la verificacion de firma HMAC del payload del banco.
C2P_REQUIRE_SIGNATURE=false
C2P_SIGNATURE_SECRET=
C2P_SWITCH_TIMEOUT_MS=4000

# --- Semilla opcional ------------------------------------------------
# Si se define, "npm run seed" activa las cuentas de demostracion con esta clave.
SEED_PASSWORD=
