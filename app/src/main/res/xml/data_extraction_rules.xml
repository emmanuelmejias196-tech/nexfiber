<?xml version="1.0" encoding="utf-8"?><!--
    Reglas de extraccion de datos (Android 12+).

    Sin copia en la nube ni transferencia entre dispositivos: los datos del
    cliente (contratos, tickets y sesion) no deben salir del telefono.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
