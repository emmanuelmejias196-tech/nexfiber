<?xml version="1.0" encoding="utf-8"?><!--
    Reglas de copia de seguridad (Android 11 y anteriores).

    La app guarda contratos, tickets y la sesion del cliente. Ninguno de esos
    datos debe salir del dispositivo, por lo que se excluyen base de datos y
    Preferencias compartidas de cualquier copia.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
